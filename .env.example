# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_INPUT_BUCKET=splatafrika-input
AWS_S3_OUTPUT_BUCKET=splatafrika-output
AWS_CLOUDFRONT_DOMAIN=your_cloudfront_domain

# Payments — Dodo (International Cards)
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PRODUCT_STANDARD_ONE_OFF=prod_xxx
DODO_PRODUCT_PREMIUM_ONE_OFF=prod_xxx
DODO_PRODUCT_STANDARD_SUBSCRIPTION=prod_xxx
DODO_PRODUCT_PREMIUM_SUBSCRIPTION=prod_xxx

# Payments — Paystack (M-Pesa + African Cards)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Email — AWS SES (SMTP)
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your_ses_smtp_username
SMTP_PASSWORD=your_ses_smtp_password
SMTP_FROM=noreply@splatafrika.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
